# Copy to .env.local for local development. Never commit real values.
# On Render or Hugging Face, set these in the service's environment settings instead.

# --- Qloo (required) --------------------------------------------------------------------
# Hackathon API host. Keys only work against this host.
QLOO_BASE_URL=https://hackathon.api.qloo.com
# Host the qloo harness trusts with the key (keep it the same as QLOO_BASE_URL).
QLOO_TRUSTED_BASE_URL=https://hackathon.api.qloo.com
# Your Qloo hackathon key. Read only by the server-side `qloo mcp` process, never sent to the browser.
QLOO_API_KEY=your-qloo-hackathon-key

# --- LLM for the agent layer (optional) -------------------------------------------------
# Without a key Opener runs its deterministic planner and the generic tour falls back to a
# population baseline. Set ONE key; the provider is picked from whichever key is present.
# Free Gemini key from https://aistudio.google.com
GEMINI_API_KEY=your-gemini-key
# Anthropic key (takes priority over Gemini when both are set).
# ANTHROPIC_API_KEY=your-anthropic-key
# Force a provider when both keys are set: gemini or anthropic.
# LLM_PROVIDER=gemini
# Override the model (must match the provider, e.g. gemini-3.8-flash or claude-sonnet-5-5).
# LLM_MODEL=gemini-3.6-flash
# Comma-separated Gemini models to try when the first is busy or out of quota.
# GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite
# Set to "off" to disable Anthropic's server-side refusal fallback.
# OPENER_LLM_FALLBACKS=off

# --- Optional tuning --------------------------------------------------------------------
# Port for `npm start` (Render and Docker set this; default 3000).
# PORT=3000
# Where the 24h Qloo and plan cache lives on disk (empty string = memory only).
# OPENER_CACHE_DIR=.cache/qloo
# How long cached Qloo results and plans stay fresh, in hours.
# OPENER_CACHE_TTL_HOURS=24
# New (uncached) plans each IP can start per minute.
# OPENER_RATE_LIMIT_PER_MINUTE=5
# How long the agent loop may run before the deterministic planner takes over, in ms.
# OPENER_AGENT_TIME_MS=90000
# Load saved sample plans from data/samples into the cache when the server starts.
# OPENER_WARM_ON_START=true
# Folder with saved sample plans (default data/samples).
# OPENER_SAMPLES_DIR=data/samples
# Link to the source code shown in the site footer.
# NEXT_PUBLIC_REPO_URL=https://github.com/softalpha0/Opener
