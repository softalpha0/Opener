# Copy to .env.local for local development. Never commit real values.

# Qloo hackathon API (required). The key is read only by the server-side `qloo mcp` process.
QLOO_BASE_URL=https://hackathon.api.qloo.com
QLOO_TRUSTED_BASE_URL=https://hackathon.api.qloo.com
QLOO_API_KEY=your-qloo-hackathon-key

# LLM for the agent layer (optional: without a key Opener runs its deterministic planner).
# Set ONE key. The provider is picked from whichever key is present.
GEMINI_API_KEY=your-gemini-key        # free key from https://aistudio.google.com
# ANTHROPIC_API_KEY=your-anthropic-key
# LLM_PROVIDER=gemini                 # only needed if both keys are set
# LLM_MODEL=gemini-3.8-flash          # optional override (claude-sonnet-5-5 for Anthropic)

# Optional tuning
# OPENER_CACHE_DIR=.cache/qloo
# OPENER_CACHE_TTL_HOURS=24
# OPENER_RATE_LIMIT_PER_MINUTE=5
