{
  "name": "opener",
  "version": "1.0.0",
  "private": true,
  "description": "Opener: an AI tour-routing agent for independent musicians, powered by Qloo's taste graph.",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p ${PORT:-3000}",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "inspect-tools": "node scripts/inspect-tools.mjs",
    "plan": "tsx scripts/plan-cli.ts",
    "warm-cache": "node scripts/warm-cache.mjs",
    "test:all": "npm run lint && npm run typecheck && npm run test && npm run test:e2e"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "maplibre-gl": "^5.24.0",
    "next": "^15.5.28",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.28",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
